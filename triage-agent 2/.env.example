# Copy to .env. With OFFLINE_MODE=true everything runs with no API key (heuristic stand-ins).
OFFLINE_MODE=false

# LLMs run on Groq (OpenAI-compatible API). Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Groq model IDs, see https://console.groq.com/docs/models . Small model classifies, larger drafts.
CLASSIFY_MODEL=openai/gpt-oss-20b
DRAFT_MODEL=openai/gpt-oss-120b
INSIGHTS_MODEL=openai/gpt-oss-20b

# Give the drafting agent the knowledge-search tool.
RESOLVE_USE_TOOL=false

# fastembed = multilingual dense + BM25 (downloads ~250 MB on first run); hash = offline, not semantic
EMBEDDINGS=fastembed
# Cosine similarity that counts as a strong knowledge match for the dense model
RELEVANCE_FULL=0.7

# Gate: score at or above this, with no risk flags, is sent automatically
GATE_THRESHOLD=0.85
